# No NODE_ENV here: Vite would pick it up and build React in dev mode.
API_PORT=3000
MONGODB_URI=mongodb://localhost:27017/easygenerator
JWT_SECRET=dev-only-change-me-0123456789abcdef
CORS_ORIGIN=http://localhost:5173

# Rate limiting. Defaults are 60000 / 100 / 5 when unset.
THROTTLE_TTL_MS=60000
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_AUTH_LIMIT=5

MONGO_PORT=27017
MONGO_DB=easygenerator

VITE_API_URL=http://localhost:3000/api/v1
