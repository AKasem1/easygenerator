{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node", "vitest/globals"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": "../..",
    "outDir": "./dist",
    "paths": {
      "@shared": ["../../shared/index"],
      "@shared/*": ["../../shared/*"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src/**/*.ts", "../../shared/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
