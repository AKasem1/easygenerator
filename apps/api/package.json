{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API",
  "scripts": {
    "dev": "pnpm run build && concurrently -k -n tsc,alias,api -c gray,blue,cyan \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"tsc-alias -p tsconfig.build.json --watch\" \"node --watch dist/main.js\"",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/postbuild.mjs",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.5.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "mongoose": "9.10.0",
    "nestjs-pino": "5.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "3.0.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.5",
    "mongodb-memory-server": "11.2.0",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "tsc-alias": "1.9.4",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
