# This project is deliberately NOT a pnpm workspace, so settings that pnpm 11
# would otherwise persist into pnpm-workspace.yaml are declared here instead.

# pnpm 11 gates packages published in the last 24h; opting out keeps installs
# reproducible without pnpm writing an exclusion list to a workspace file.
minimum-release-age=0

# @swc/core ships a platform binary and needs its install script to run.
only-built-dependencies[]=@swc/core
